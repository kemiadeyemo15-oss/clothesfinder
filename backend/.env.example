# Copy to .env and fill as you flip each subsystem to its real impl.
# With NOTHING set, the app runs fully on stubs (no keys, no DB).

# --- choose implementations ---
CF_REPO_BACKEND=memory        # memory | postgres
CF_EMBEDDER=stub              # stub | lykdat
CF_INVENTORY=seed             # seed | shopping_api
CF_QUERY_PARSER=rules         # rules | llm
CF_ENV=dev                    # dev | prod

# --- Postgres (CF_REPO_BACKEND=postgres) ---
CF_DATABASE_URL=postgresql+asyncpg://clothesfinder:clothesfinder@localhost:5432/clothesfinder

# --- Lykdat embeddings (CF_EMBEDDER=lykdat) ---
CF_LYKDAT_API_KEY=
CF_LYKDAT_BASE_URL=https://api.lykdat.com/v1
CF_EMBEDDING_DIM=512          # MUST match the model you wire in

# --- shopping-search inventory (CF_INVENTORY=shopping_api) ---
CF_SHOPPING_API_KEY=
CF_SHOPPING_API_URL=

# --- LLM query parsing (CF_QUERY_PARSER=llm) ---
CF_LLM_API_KEY=
CF_LLM_MODEL=claude-3-5-haiku

# --- CORS (frontend origin) ---
# CF_CORS_ORIGINS=["https://your-frontend.vercel.app"]
